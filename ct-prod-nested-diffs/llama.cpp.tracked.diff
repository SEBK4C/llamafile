+    // GGML_METAL_CAPTURE_COMPUTE), then resume normal operation
+    {
+        static int profile_compute = -2;
+        if (profile_compute == -2) {
+            const char * val = getenv("GGML_METAL_PROFILE_COMPUTE");
+            profile_compute = val ? atoi(val) : -1;
+        }
+        if (profile_compute >= 0) {
+            profile_compute--;
+            if (profile_compute == 0) {
