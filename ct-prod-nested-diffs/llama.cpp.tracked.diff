     @autoreleasepool {
         ctx->gf = gf;
 
+        // calibration aid for GGML_METAL_CAPTURE_COMPUTE: maps compute index
+        // to request sequence (see docs/metal-batch-kickoff.md)
+        if (getenv("GGML_METAL_COUNT_COMPUTE")) {
+            static _Atomic int gc_counter = 0;
+            fprintf(stderr, "[graph-compute] #%d n_nodes=%d\n", ++gc_counter, gf->n_nodes);
+        }
+
         ctx->n_nodes_0 = MIN(n_main, gf->n_nodes);
         ctx->n_nodes_1 = gf->n_nodes - ctx->n_nodes_0;
 
